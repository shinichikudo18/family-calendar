[Unit]
Description=Family Calendar Celery Worker
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/family-calendar/backend
EnvironmentFile=/opt/family-calendar/.env
ExecStart=/opt/family-calendar/.venv/bin/celery -A config worker     --loglevel=info     --concurrency=4
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
