[Unit]
Description=Family Calendar Gunicorn
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=calendar
Group=calendar
WorkingDirectory=/opt/family-calendar/backend
EnvironmentFile=/opt/family-calendar/.env
ExecStart=/opt/family-calendar/.venv/bin/gunicorn config.wsgi:application     --bind 0.0.0.0:8000     --workers 4     --threads 2     --worker-class=gthread     --timeout 120     --access-logfile /var/log/family-calendar/gunicorn-access.log     --error-logfile /var/log/family-calendar/gunicorn-error.log     --log-level info
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
